  metricB: { flex: 1, display: "flex", flexDirection: "column", gap: 8, paddingLeft: 10, borderLeft: "1px solid rgba(255,255,255,0.08)", minWidth: 0 },
  smallRow: { display: "flex", alignItems: "center", justifyContent: "space-between", gap: 10 },
  k: { color: "rgba(148,163,184,0.95)", fontWeight: 900, fontSize: 12 },
  valChip: { padding: "6px 9px", borderRadius: 999, border: "1px solid rgba(255,255,255,0.10)", fontSize: 12, fontWeight: 950, letterSpacing: 0.35, minWidth: 78, textAlign: "center" },
  last: { fontSize: 12, fontWeight: 950, color: "rgba(226,232,240,0.92)" },

  err: { padding: 10, borderRadius: 14, background: "rgba(239,68,68,0.10)", border: "1px solid rgba(239,68,68,0.28)", color: "rgba(254,202,202,0.95)", fontSize: 12, fontWeight: 850 },
